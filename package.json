{
  "name": "model-bench",
  "version": "0.1.0",
  "private": true,
  "description": "Ingests LLM benchmark data via @shrinivas-sn/adapter-ingestion and serves an interactive playground for choosing the best model per work type",
  "scripts": {
    "dev": "next dev",
    "build": "node normalization/build-data.mjs && next build",
    "start": "next start",
    "ingest": "node ingestion/run-all.mjs",
    "verify:fixtures": "node ingestion/verify-fixtures.mjs",
    "build:data": "node normalization/build-data.mjs",
    "test": "node --test ingestion/test/*.test.mjs normalization/test/*.test.mjs",
    "deploy": "npm run build && node --dns-result-order=ipv4first ./node_modules/wrangler/bin/wrangler.js deploy"
  },
  "dependencies": {
    "@shrinivas-sn/adapter-ingestion": "^0.2.0",
    "cmdk": "^1.1.1",
    "next": "^15.5.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "puppeteer-core": "^25.12.0",
    "typescript": "^5.8.0",
    "wrangler": "^4.141.0"
  }
}
