{
  "version": 1,
  "host": "artificialanalysis.ai",
  "access": {
    "tier": 0,
    "kind": "json-api",
    "url": "https://artificialanalysis.ai/api/v2/language/models/free"
  },
  "fetch": {
    "method": "GET",
    "timeout_ms": 60000,
    "max_records": 500,
    "max_response_bytes": 20971520
  },
  "records_path": "$",
  "map": {
    "source_id": { "path": "source_id" },
    "url": { "path": "page_url" },
    "title": { "path": "name", "normalize": "text" },
    "creator": { "path": "creator", "normalize": "text" },
    "slug": { "path": "slug", "normalize": "text" },
    "release_date": { "path": "release_date", "normalize": "iso-date" },
    "intelligence_index": { "path": "intelligence_index", "normalize": "number" },
    "coding_index": { "path": "coding_index", "normalize": "number" },
    "agentic_index": { "path": "agentic_index", "normalize": "number" },
    "price_in": { "path": "price_in", "normalize": "number" },
    "price_out": { "path": "price_out", "normalize": "number" },
    "output_tps": { "path": "output_tps", "normalize": "number" },
    "ttft_s": { "path": "ttft_s", "normalize": "number" }
  },
  "required": ["title"],
  "canary": {
    "min_records": 20,
    "median_window": 5,
    "count_drop_ratio": 0.4,
    "required_field_ratio": 0.9
  }
}
